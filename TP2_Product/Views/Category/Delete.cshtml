@model Category

@{
    ViewData["Title"] = "Delete";
}

<div class="page-header">
    <h1><i class="bi bi-trash me-2 text-danger"></i>Supprimer la catégorie</h1>
</div>

<div class="card" style="max-width: 520px; border: 1px solid #fecaca;">
    <div class="card-body p-4">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-1"></i>Are you sure you want to delete this?
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.CategoryName)</dt>
            <dd class="col-sm-8 fw-semibold">@Html.DisplayFor(model => model.CategoryName)</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.CategoryId" class="d-flex gap-2">
            <input type="hidden" asp-for="CategoryId" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
            <a asp-action="Index" class="btn btn-outline-primary">Back to List</a>
        </form>
    </div>
</div>