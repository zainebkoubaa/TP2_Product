@model IEnumerable<TP_Product.Models.Category>

@{
    ViewData["Title"] = "Catégories";
    bool canManage = User.IsInRole("Admin");
}

<div class="page-header">
    <h1><i class="bi bi-tags me-2 text-primary"></i>Catégories</h1>
    @if (canManage)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Nouvelle catégorie
        </a>
    }
</div>

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.CategoryName)</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@Html.DisplayFor(model => item.CategoryName)</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye me-1"></i>Details
                            </a>
                            @if (canManage)
                            {
                                <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-danger btn-sm">
                                    <i class="bi bi-trash me-1"></i>Delete
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>