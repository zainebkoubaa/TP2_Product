@model TP_Product.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "User Registration";
}

<div class="card auth-card">
    <div class="card-body">
        <div class="auth-title">
            <div class="auth-icon"><i class="bi bi-person-plus"></i></div>
            <h2>Créer un compte</h2>
            <p class="text-muted mb-0">Rejoignez la plateforme</p>
        </div>

        <form method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control" placeholder="exemple@gmail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password" class="control-label"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword" class="control-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-check2-circle me-1"></i>Register
            </button>

            <p class="text-center text-muted mt-3 mb-0">
                Déjà un compte ?
                <a asp-controller="Account" asp-action="Login">Login</a>
            </p>
        </form>
    </div>
</div>