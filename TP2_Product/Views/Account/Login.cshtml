@model TP_Product.ViewModels.LoginViewModel
@{
    ViewBag.Title = "User Login";
    var returnUrl = Context.Request.Query["ReturnUrl"];
}

<div class="card auth-card">
    <div class="card-body">
        <div class="auth-title">
            <div class="auth-icon"><i class="bi bi-person-lock"></i></div>
            <h2>Connexion</h2>
            <p class="text-muted mb-0">Accédez à votre compte</p>
        </div>

        <form asp-route-returnurl="@returnUrl" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" placeholder="exemple@gmail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label fw-normal"></label>
            </div>

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i>Login
            </button>

            <p class="text-center text-muted mt-3 mb-0">
                Pas encore de compte ?
                <a asp-controller="Account" asp-action="Register">Register</a>
            </p>
        </form>
    </div>
</div>