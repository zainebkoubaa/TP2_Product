@{
    ViewBag.Title = "Access Denied";
}

<div class="card auth-card text-center">
    <div class="card-body">
        <div class="auth-icon" style="background:#fee2e2; color:#dc2626;">
            <i class="bi bi-slash-circle"></i>
        </div>
        <h2 class="text-danger">Access Denied</h2>
        <p class="text-muted">You do not have permission to view this resource</p>
        <img src="~/images/noaccess.png" alt="Access denied" style="height:180px; width:180px;" class="mb-3" />
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house-door me-1"></i>Retour à l'accueil
            </a>
        </div>
    </div>
</div>