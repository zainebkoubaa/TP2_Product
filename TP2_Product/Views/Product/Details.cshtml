@model TP_Product.Models.Product

@{
    ViewData["Title"] = "Details";
    var photoPath = "~/images/" + (Model.Image ?? "noimage.jpg");
    string currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="page-header">
    <h1><i class="bi bi-info-circle me-2 text-primary"></i>Détails du produit</h1>
</div>

<div class="card @(Model.QteStock <= 0 ? "out-of-stock" : "")">
    <div class="row g-0">
        <div class="col-md-4 d-flex align-items-center justify-content-center p-3" style="background:#eef2f7;">
            <img src="@photoPath" asp-append-version="true" class="img-fluid" style="max-height:260px; object-fit:contain;" alt="@Model.Name" />
        </div>
        <div class="col-md-8">
            <div class="card-body p-4">
                <span class="category-pill mb-2">@Html.DisplayFor(model => model.Category.CategoryName)</span>
                <h2 class="mt-2">@Html.DisplayFor(model => model.Name)</h2>

                <div class="mt-2">
                    <partial name="_StockBadge" model="Model.QteStock" />
                </div>

                <dl class="row mt-4 mb-0">
                    <dt class="col-sm-4">Prix unitaire</dt>
                    <dd class="col-sm-8 price-tag"><partial name="_Price" model="Model.Price" /></dd>

                    <dt class="col-sm-4">Disponibilité</dt>
                    <dd class="col-sm-8">
                        @if (Model.QteStock <= 0)
                        {
                            <span>Indisponible pour le moment</span>
                        }
                        else
                        {
                            <span>Disponible</span>
                        }
                    </dd>

                    @if (User.IsInRole("Admin"))
                    {
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.QteStock)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.QteStock)</dd>
                    }

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Category)</dt>
                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Category.CategoryName)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="card-footer bg-white border-0 p-3 d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model?.ProductId" asp-route-returnUrl="@currentUrl" class="btn btn-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
        }
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
    </div>
</div>