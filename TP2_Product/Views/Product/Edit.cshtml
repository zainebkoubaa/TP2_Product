@model TP_Product.ViewModels.EditViewModel

@{
    ViewData["Title"] = "Edit";
    var photoPath = "~/images/" + (Model.ExistingImagePath ?? "noimage.jpg");
    string returnUrl = ViewBag.ReturnUrl as string ?? "";
    string cancelUrl = string.IsNullOrEmpty(returnUrl) ? Url.Action("Index", "Product")! : returnUrl;
}

<div class="page-header">
    <h1><i class="bi bi-pencil-square me-2 text-primary"></i>Modifier l'article</h1>
</div>

<div class="card" style="max-width: 640px;">
    <div class="card-body p-4">
        <form asp-controller="Product" asp-action="Edit" enctype="multipart/form-data" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <input hidden asp-for="ProductId" />
            <input hidden asp-for="ExistingImagePath" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 form-group">
                    <label asp-for="PriceText" class="control-label"></label>
                    <input asp-for="PriceText" class="form-control" placeholder="Ex : 9DT000" autocomplete="off" />
                    <div class="form-text">Format obligatoire : <b>9DT000</b> (9 dinars, 000 millimes)</div>
                    <span asp-validation-for="PriceText" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="QteStock" class="control-label"></label>
                    <input asp-for="QteStock" class="form-control" />
                    <span asp-validation-for="QteStock" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId" class="control-label">Catégorie</label>
                <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ImagePath" class="control-label">Changer la photo (optionnel)</label>
                <input asp-for="ImagePath" class="form-control custom-file-input" id="imageInput" accept="image/*" data-val="false" />
                <div class="form-text">Laissez vide pour garder la photo actuelle.</div>
                <img id="imageEmp" src="@photoPath" asp-append-version="true" class="mt-3 rounded border" style="height:120px; width:120px; object-fit:contain; background:#eef2f7;" alt="Photo" />
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Update
                </button>
                <a href="@cancelUrl" class="btn btn-outline-primary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('.custom-file-input').on("change", function () {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#imageEmp').attr('src', e.target.result);
                    };
                    reader.readAsDataURL(this.files[0]);
                }
            });
        });
    </script>
}