@model Product

@{
    ViewData["Title"] = "Delete";
    string returnUrl = ViewBag.ReturnUrl as string ?? "";
    string backUrl = string.IsNullOrEmpty(returnUrl) ? Url.Action("Index", "Product")! : returnUrl;
}

<div class="page-header">
    <h1><i class="bi bi-trash me-2 text-danger"></i>Supprimer l'article</h1>
</div>

<div class="card" style="max-width: 640px; border: 1px solid #fecaca;">
    <div class="card-body p-4">
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-1"></i>Are you sure you want to delete this?
        </div>

        <dl class="row mb-4">
            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Name)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

            <dt class="col-sm-4">Prix unitaire</dt>
            <dd class="col-sm-8"><partial name="_Price" model="Model.Price" /></dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.QteStock)</dt>
            <dd class="col-sm-8">@Html.DisplayFor(model => model.QteStock)</dd>

            <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Category)</dt>
            <dd class="col-sm-8">@Model.Category?.CategoryName</dd>
        </dl>

        <form asp-action="Delete" asp-route-id="@Model.ProductId" class="d-flex gap-2">
            <input type="hidden" asp-for="ProductId" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-trash me-1"></i>Delete
            </button>
            <a href="@backUrl" class="btn btn-outline-primary">Back to List</a>
        </form>
    </div>
</div>